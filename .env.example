# Use your actual deployed domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://bricks-breaker-ball.vercel.app

# Verify this exact Google Play listing URL in Play Console before publishing.
# The fallback package ID in lib/site.ts is based on the Android project name.
NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.forgepulse.brickbreakerball

# Leave blank until a real iOS App Store page is available.
# Once set, an official black App Store badge appears alongside Google Play.
NEXT_PUBLIC_APP_STORE_URL=
