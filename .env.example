# Use your actual deployed domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://bricks-breaker-ball.vercel.app

# Verify this exact Google Play listing URL in Play Console before publishing.
# The fallback package ID in lib/site.ts is based on the Android project name.
NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.forgepulse.brickbreakerball

# Leave blank until a real iOS App Store page is available.
# Once set, an official black App Store badge appears alongside Google Play.
NEXT_PUBLIC_APP_STORE_URL=

# Firebase Web app configuration (safe to expose in the browser bundle).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=brick-breaker-ball-8e4f5.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=brick-breaker-ball-8e4f5
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=brick-breaker-ball-8e4f5.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1090595999482
NEXT_PUBLIC_FIREBASE_APP_ID=1:1090595999482:web:f957ece84abf9e075ac343
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-61EXQEER23

# The only Google account allowed to open /ar/editor and /en/editor.
NEXT_PUBLIC_FIREBASE_ADMIN_EMAIL=alromaihi2224@gmail.com
